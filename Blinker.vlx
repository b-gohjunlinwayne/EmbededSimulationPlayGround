    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Blink LED Example\n// Toggles the built-in LED on pin 13\n\nconst int c_blinkQuickDuration = 50;\nconst int c_blinkSlowDuration = 500;\nconst unsigned int c_ledPin = 13;\n\nvoid setup() {\n  pinMode(c_ledPin, OUTPUT);\n}\n\nvoid Blink(int Duration){\n  digitalWrite(c_ledPin,HIGH);\n  delay(Duration);\n  digitalWrite(c_ledPin,LOW);\n  delay(Duration);\n}\n\nvoid loop() {\n  for(int i = 0; i < 2; ++i)\n  {\n    Blink(c_blinkQuickDuration);\n  }\n  for(int i = 0; i < 2; ++i)\n  {\n    Blink(c_blinkSlowDuration);\n  }\n  delay(2000);\n}"
      }
    ]
  },
